# Keep LF in source and scripts: a CRLF shell script fails on Linux with
# "$'\r': command not found" and half-executes.
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.json text eol=lf

# CONTRACT DATA - NEVER NORMALISE.
# training_r0/data/*.json is hashed by current_contract(); its bytes ARE the contract.
# nominal_combat.json, reference_features.json and native_definitions.json contain CRLF on
# purpose. Rewriting them changes the contract hash and silently invalidates every dataset
# (the trainer then rejects all battles as "compiled under another contract").
training_r0/data/*.json -text

*.npz  binary
*.zst  binary
*.pt   binary
